{
  "expo": {
    "name": "Speak&Go",
    "slug": "speakandgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/SpeakAndGo-Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "speakandgo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.speakandgo.app"
    },
    "android": {
      "package": "com.speakandgo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Speak&Go to access your microphone."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite accesul la cameră pentru scanarea biletelor."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "baseUrl": "https://7b0f-2a02-2f05-2118-ed00-147e-5164-831c-13f0.ngrok-free.app"
    }
  }
}
